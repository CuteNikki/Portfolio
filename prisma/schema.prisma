// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER // Can only read and comment
  WRITER // Can read, comment and create posts
  ADMIN // Can do everything, including managing other users
}

model User {
  id          String  @id @default(cuid())
  discordId   String  @unique
  displayName String?
  username    String
  avatarUrl   String
  role        Role    @default(USER)

  accessToken    String? @db.Text
  refreshToken   String? @db.Text
  tokenExpiresAt Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  comments       Comment[]
  postAuthors    PostAuthor[]
  projectAuthors ProjectAuthor[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime

  // Shown on the account page, so people can tell their devices apart and sign out ones they don't use
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id       String  @id @default(cuid())
  title    String
  slug     String? @unique
  content  String  @db.Text
  views    Int     @default(0)
  // The cover picture, stored on our own image server (see src/lib/images.ts)
  coverUrl String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authors  PostAuthor[]
  comments Comment[]
}

// The people who wrote a post, in the order they're shown: someone who signed in, or someone without an account with
// just a name and maybe a link. Removing a user only removes them from the list.
model PostAuthor {
  id       String  @id @default(cuid())
  postId   String
  userId   String?
  name     String?
  url      String?
  position Int     @default(0)

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Comment {
  id       String  @id @default(cuid())
  postId   String
  parentId String? // For nested comments
  authorId String
  content  String  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentToComment")
}

model Project {
  id          String  @id @default(cuid())
  title       String
  slug        String? @unique
  description String  @db.Text

  tags         String[]
  technologies String[]

  // Optional links related to the project
  repository String?
  website    String?

  // The cover picture and further pictures, stored on our own image server (see src/lib/images.ts)
  coverUrl     String?
  // The cover for dark themes, if the project has one; the cover above is used everywhere else
  coverDarkUrl String?
  images       ProjectImage[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authors ProjectAuthor[]
}

// The people who made a project, like PostAuthor
model ProjectAuthor {
  id        String  @id @default(cuid())
  projectId String
  userId    String?
  name      String?
  url       String?
  position  Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// A project's pictures after the cover, in the order they're shown
model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  url       String
  // Describes the picture for screen readers
  alt       String @default("")
  position  Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
}

// Fixed-window counters for rate limits, e.g. contact form sends per visitor or one counted view per visitor and post.
// Keys hold hashed IPs, never raw ones, and expired rows are cleared on the next write.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
