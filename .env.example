DATABASE_URL=postgresql://john:password@127.0.0.1:5432/mydb

NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret

SMTP_URL=smtps://no-reply%40domain.com:password@mail.domain.com
EMAIL_FROM=no-reply@domain.com
EMAIL_TO=contact@domain.com
# Pictures for posts and projects, in the site's own bucket on our Garage server (see the README's Pictures section)
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Optional: another S3-compatible server and where its pictures are read from (defaults in src/lib/storage.ts)
# STORAGE_ENDPOINT="https://s3.example.com"
# STORAGE_BUCKET="portfolio"
# IMAGE_PUBLIC_URL="https://images.example.com"
# Optional: the folder pictures are uploaded to, e.g. "portfolio/aB3dE5fG7hI9". Without it, the folder is named after
# DATABASE_URL's address, so set it to the existing folder when the database moves or is reached another way
# STORAGE_FOLDER=""
